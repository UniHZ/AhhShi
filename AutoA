-- CORE LOGIC: TARGET ACQUISITION (RANGE 300)
-- ==========================================
local function getClosestTarget()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local closest = nil
    local shortestDist = 240

    for _, obj in ipairs(Workspace:GetChildren()) do
        local function checkTarget(targetObj)
            if targetObj:IsA("Model") then
                local hum = targetObj:FindFirstChildOfClass("Humanoid")
                local targetRoot = targetObj:FindFirstChild("HumanoidRootPart") or targetObj.PrimaryPart
                
                if hum and hum.Health > 0 and targetRoot then
                    local nameLower = string.lower(targetObj.Name)
                    local isMatch = false
                    for _, targetName in ipairs(getgenv().Cyber_Targets) do
                        if string.find(nameLower, targetName, 1, true) then isMatch = true; break end
                    end
                    
                    if isMatch and targetObj ~= char then
                        local dist = (targetRoot.Position - hrp.Position).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            closest = targetObj
                        end
                    end
                end
            end
        end

        if obj:IsA("Model") then checkTarget(obj)
        elseif obj:IsA("Folder") then
            for _, subObj in ipairs(obj:GetChildren()) do checkTarget(subObj) end
        end
    end
    return closest
end

