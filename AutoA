-- MAIN LOOP (TARGET LOCK & DYNAMIC TP DISTANCE)
-- ==========================================
task.spawn(function()
    local SCAN_INTERVAL = jit(0.15)
    
    while isAlive and ScreenGui and ScreenGui.Parent do
        task.wait(SCAN_INTERVAL)
        
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")

        -- GOD MODE
        if GodModeEnabled and hum then
            pcall(function() hum.MaxHealth = math.huge; hum.Health = math.huge end)
        end

        if not (AutoAttackEnabled or AutoTPEnabled) then
            task.wait(0.5)
            currentTarget = nil
        else
            -- LOGIKA TARGET LOCK
            if currentTarget then
                local targetHum = currentTarget:FindFirstChild("Humanoid")
                local targetRoot = currentTarget:FindFirstChild("HumanoidRootPart") or currentTarget.PrimaryPart
                
                if not targetHum or targetHum.Health <= 0 or not targetRoot or (targetRoot.Position - hrp.Position).Magnitude > 300 then
                    currentTarget = nil
                end
            end

            if not currentTarget then
                currentTarget = getClosestTarget()
            end
            
            if currentTarget then
                local targetHum = currentTarget:FindFirstChild("Humanoid")
                local targetHRP = currentTarget:FindFirstChild("HumanoidRootPart") or currentTarget.PrimaryPart
                
                if targetHum and targetHRP then
                    
                    -- ==========================================
                    -- LOGIKA AUTO TP (JARAK DINAMIS 2 DETIK)
                    -- ==========================================
                    if AutoTPEnabled then
                        -- Cek apakah sudah 2 detik untuk ganti jarak
                        if tick() - distanceTimer >= DISTANCE_TOGGLE_TIME then
                            isFarDistance = not isFarDistance
                            distanceTimer = tick()
                        end
                        
                        -- Tentukan jarak saat ini (Dekat atau Jauh)
                        local currentDistance = isFarDistance and DISTANCE_FAR or DISTANCE_CLOSE
                        
                        -- Hitung posisi di belakang musuh dengan jarak dinamis
                        local behindPos = targetHRP.CFrame * CFrame.new(0, 0, currentDistance) 
                        
                        hrp.CFrame = behindPos
                        hrp.Velocity = Vector3.new(0, 0, 0)
                        hrp.RotVelocity = Vector3.new(0, 0, 0)
                        task.wait(0.05) 
                    end

                    -- ==========================================
                    -- LOGIKA EKSEKUSI SERANGAN
                    -- ==========================================
                    local aimDir = (targetHRP.Position - hrp.Position).Unit
                    
                    if CurrentWeaponType == "Gun" then
                        pcall(function()
                            local CombatRemote = ReplicatedStorage:FindFirstChild("OD_Remotes") and ReplicatedStorage.OD_Remotes:FindFirstChild("Combat")
                            if CombatRemote then
                                CombatRemote:FireServer("shoot", {targetHRP.Position}, {targetHRP})
                            end
                        end)
                    elseif CurrentWeaponType == "Melee" then
                        pcall(function()
                            local MeleeRemote = ReplicatedStorage:FindFirstChild("RemoteEvents") and ReplicatedStorage.RemoteEvents:FindFirstChild("MeleeAttack")
                            if MeleeRemote then
                                local args = {
                                    [1] = 4,
                                    [2] = targetHRP.Position,
                                    [3] = aimDir
                                }
                                MeleeRemote:FireServer(unpack(args))
                            end
                        end)
                    end
                    
                    local modeText = AutoTPEnabled and "TP ATTACK" or "RANGED ATTACK"
                    local distText = AutoTPEnabled and (isFarDistance and " [FAR]" or " [CLOSE]") or ""
                    InfoText.Text = "STATUS: " .. modeText .. distText .. "\nLOCKED: " .. currentTarget.Name .. "\nHP: " .. math.floor(targetHum.Health)
                    InfoText.TextColor3 = Color3.fromRGB(0, 255, 255)
                end
            else
                InfoText.Text = "STATUS: SCANNING (<=300 STUDS)...\nNO VALID TARGET"
                InfoText.TextColor3 = Themes[CurrentTheme].SubText
            end
        end
    end
end)
